<?xml version="1.0" encoding="utf-8"?>
<!-- Estante de cristal esmerilado detrás del dock (estilo tvOS): se tiene que ver. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="270" android:startColor="#5CFFFFFF" android:centerColor="#3DFFFFFF" android:endColor="#2EFFFFFF" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.35" />
        </shape>
    </item>
</layer-list>
