<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/wallA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/wallB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/clockBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp">

        <com.alfredo.launchertv.GlassTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView
        android:id="@+id/fgA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/fgB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <!-- Modo noche (temporizador de Dormir): la foto, la montaña y el reloj se oscurecen poco a poco. -->
    <View
        android:id="@+id/nightShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF140C04"
        android:alpha="0" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/scrim"
        android:background="@drawable/scrim" />

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0" />

    <!-- Encendido: negro sobre la foto; el reloj aparece primero (por encima, con translationZ). -->
    <View
        android:id="@+id/bootShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:alpha="0"
        android:visibility="gone" />

    <com.alfredo.launchertv.RowsScrollView
        android:id="@+id/rowsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="40dp">

            <Space
                android:id="@+id/topSpace"
                android:layout_width="match_parent"
                android:layout_height="248dp" />
        </LinearLayout>
    </com.alfredo.launchertv.RowsScrollView>

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/overlayBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.55"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000" />

        <TextView
            android:id="@+id/overlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="44dp"
            android:text="@string/all_apps_title"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="92dp"
            android:text="@string/all_apps_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="64dp"
            android:layout_marginBottom="28dp"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="132dp"
            android:paddingStart="52dp"
            android:paddingEnd="52dp"
            android:paddingBottom="40dp"
            android:clipToPadding="false"
            android:clipChildren="false" />
    </FrameLayout>

    <!-- Animación al abrir una app: el icono crece hasta llenar la pantalla y se funde a negro. -->
    <View
        android:id="@+id/launchBlack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:alpha="0"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/launchZoom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Avisos propios: arriba a la derecha, dentro de la zona segura (como en Apple TV). -->
    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="52dp"
        android:maxWidth="560dp"
        android:background="@drawable/toast_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:alpha="0"
        android:elevation="16dp"
        android:visibility="gone" />
</FrameLayout>
